generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
}

model AdminUser {
  id           String   @id @default(cuid())
  username     String   @unique
  email        String?  @unique
  name         String?
  passwordHash String
  role         Role     @default(ADMIN)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([role, active])
}

model ProductCost {
  id            String         @id @default(cuid())
  productId     String         @unique
  marginPercent Decimal        @default(0) @db.Decimal(10, 2)
  machinePercent Decimal       @default(0) @db.Decimal(10, 2)
  materials     CostMaterial[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model CostMaterial {
  id            String      @id @default(cuid())
  productCostId String
  productCost   ProductCost @relation(fields: [productCostId], references: [id], onDelete: Cascade)
  name          String
  unit          String
  quantity      Decimal     @default(0) @db.Decimal(12, 3)
  unitPrice     Decimal     @default(0) @db.Decimal(12, 2)
  sortOrder     Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([productCostId, sortOrder])
}

model CatalogProduct {
  id          String                @id @default(cuid())
  name        String
  category    String
  subcategory String?
  collection  String?
  description String?
  details     String[]              @default([])
  features    String[]              @default([])
  material    String?
  dimensions  String?
  price       Decimal?              @db.Decimal(12, 2)
  pixPrice    Decimal?              @db.Decimal(12, 2)
  active      Boolean               @default(true)
  sortOrder   Int                   @default(0)
  images      CatalogProductImage[]
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@index([active, sortOrder])
  @@index([category, subcategory])
}

model CatalogProductImage {
  id        String         @id @default(cuid())
  productId String
  product   CatalogProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  mimeType  String
  data      Bytes
  sortOrder Int            @default(0)
  createdAt DateTime       @default(now())

  @@index([productId, sortOrder])
}
